{
  "problem_id": "findPeaks",
  "nodes": [
    {
      "id": 1,
      "type": "start",
      "label": "Start",
      "next": 2
    },
    {
      "id": 2,
      "type": "process",
      "label": "Input: mountain (List[int]); res = []",
      "action": "ctx['mountain'] = ctx['arg0']; ctx['res'] = []",
      "next": 3
    },
    {
      "id": 3,
      "type": "process",
      "label": "Initialize res = []",
      "action": "ctx['res'] = []",
      "next": 4
    },
    {
      "id": 4,
      "type": "process",
      "label": "For i from 1 to len(mountain) - 2: i = 1, n = len(mountain) - 2",
      "action": "ctx['i'] = 1; ctx['n'] = len(ctx['mountain']) - 2",
      "next": 9
    },
    {
      "id": 9,
      "type": "decision",
      "label": "More candidates? (i <= n)",
      "logic": "ctx['i'] <= ctx['n']",
      "true_next": 5,
      "false_next": 10
    },
    {
      "id": 5,
      "type": "decision",
      "label": "Is mountain[i] > mountain[i-1]?",
      "logic": "ctx['mountain'][ctx['i']] > ctx['mountain'][ctx['i'] - 1]",
      "true_next": 6,
      "false_next": 8
    },
    {
      "id": 6,
      "type": "decision",
      "label": "Is mountain[i] > mountain[i+1]?",
      "logic": "ctx['mountain'][ctx['i']] > ctx['mountain'][ctx['i'] + 1]",
      "true_next": 7,
      "false_next": 8
    },
    {
      "id": 7,
      "type": "process",
      "label": "Append i to res",
      "action": "ctx['res'].append(ctx['i'])",
      "next": 8
    },
    {
      "id": 8,
      "type": "process",
      "label": "Advance i: i += 1",
      "action": "ctx['i'] += 1",
      "next": 9
    },
    {
      "id": 10,
      "type": "end",
      "label": "Output: res (indices of peaks)",
      "output": "ctx['res']"
    }
  ]
}
