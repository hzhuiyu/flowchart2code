{
  "problem_id": "longestValidSubstring",
  "nodes": [
    {"id": 1, "type": "start", "label": "Start", "next": 2},
    {"id": 2, "type": "process", "label": "Input: forbidden (list of strings), word (string); init res=0, right=len(word)-1, left=len(word)-1", "action": "ctx['forbidden'] = ctx['arg0']; ctx['word'] = ctx['arg1']; ctx['forbidden_set'] = set(ctx['forbidden']); ctx['res'] = 0; ctx['right'] = len(ctx['word']) - 1; ctx['left'] = len(ctx['word']) - 1", "next": 5},
    {"id": 5, "type": "decision", "label": "left >= 0? (loop left from len(word)-1 down to 0)", "logic": "ctx['left'] >= 0", "true_next": 6, "false_next": 9},
    {"id": 6, "type": "process", "label": "Start inner scan: k = left", "action": "ctx['k'] = ctx['left']", "next": 10},
    {"id": 10, "type": "decision", "label": "k < min(left + 10, right + 1)?", "logic": "ctx['k'] < min(ctx['left'] + 10, ctx['right'] + 1)", "true_next": 7, "false_next": 11},
    {"id": 7, "type": "decision", "label": "Is word[left:k+1] in forbidden_set?", "logic": "ctx['word'][ctx['left']:ctx['k'] + 1] in ctx['forbidden_set']", "true_next": 8, "false_next": 12},
    {"id": 8, "type": "process", "label": "Forbidden prefix found: right = k - 1", "action": "ctx['right'] = ctx['k'] - 1", "next": 11},
    {"id": 12, "type": "process", "label": "k += 1", "action": "ctx['k'] += 1", "next": 10},
    {"id": 11, "type": "process", "label": "res = max(res, right - left + 1); left -= 1", "action": "ctx['res'] = max(ctx['res'], ctx['right'] - ctx['left'] + 1); ctx['left'] -= 1", "next": 5},
    {"id": 9, "type": "end", "label": "Output: res (length of longest valid substring)", "output": "ctx['res']"}
  ]
}
