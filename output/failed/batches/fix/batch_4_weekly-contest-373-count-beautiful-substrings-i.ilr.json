    {
      "id": 2,
      "type": "process",
      "label": "Input: k (integer), s (string); n, prefix counts, res init",
      "action": "ctx['k'] = ctx['arg0']; ctx['s'] = ctx['arg1']; ctx['n'] = len(ctx['s']); ctx['cnt_0'] = [0] * (ctx['n'] + 1); ctx['cnt_1'] = [0] * (ctx['n'] + 1); ctx['res'] = 0",
      "next": 3
    },
    {
      "id": 3,
      "type": "process",
      "label": "Loop through each character in s: i = 0",
      "action": "ctx['i'] = 0",
      "next": 4
    },
    {
      "id": 4,
      "type": "decision",
      "label": "More characters? (i < n)",
      "logic": "ctx['i'] < ctx['n']",
      "true_next": 5,
      "false_next": 10
    },
    {
      "id": 5,
      "type": "decision",
      "label": "Is character c a vowel?",
      "logic": "ctx['s'][ctx['i']] in 'aeiou'",
      "true_next": 6,
      "false_next": 7
    },
    {
      "id": 6,
      "type": "process",
      "label": "Vowel: cnt_0[i + 1] = cnt_0[i] + 1, cnt_1[i + 1] = cnt_1[i]",
      "action": "ctx['cnt_0'][ctx['i'] + 1] = ctx['cnt_0'][ctx['i']] + 1; ctx['cnt_1'][ctx['i'] + 1] = ctx['cnt_1'][ctx['i']]",
      "next": 8
    },
    {
      "id": 7,
      "type": "process",
      "label": "Consonant: cnt_0[i + 1] = cnt_0[i], cnt_1[i + 1] = cnt_1[i] + 1",
      "action": "ctx['cnt_0'][ctx['i'] + 1] = ctx['cnt_0'][ctx['i']]; ctx['cnt_1'][ctx['i'] + 1] = ctx['cnt_1'][ctx['i']] + 1",
      "next": 8
    },
    {
      "id": 8,
      "type": "process",
      "label": "Advance character index: i += 1",
      "action": "ctx['i'] += 1",
      "next": 4
    },
    {
      "id": 10,
      "type": "process",
      "label": "Loop i from 0 to len(s) - 1: i = 0",
      "action": "ctx['i'] = 0",
      "next": 19
    },
    {
      "id": 19,
      "type": "decision",
      "label": "Outer loop more? (i < n)",
      "logic": "ctx['i'] < ctx['n']",
      "true_next": 11,
      "false_next": 18
    },
    {
      "id": 11,
      "type": "process",
      "label": "Loop j from i + 1 to len(s): j = i + 1",
      "action": "ctx['j'] = ctx['i'] + 1",
      "next": 20
    },
    {
      "id": 20,
      "type": "decision",
      "label": "Inner loop more? (j <= n)",
      "logic": "ctx['j'] <= ctx['n']",
      "true_next": 12,
      "false_next": 21
    },
    {
      "id": 12,
      "type": "process",
      "label": "Calculate v1 = cnt_0[j] - cnt_0[i], v2 = cnt_1[j] - cnt_1[i]",
      "action": "ctx['v1'] = ctx['cnt_0'][ctx['j']] - ctx['cnt_0'][ctx['i']]; ctx['v2'] = ctx['cnt_1'][ctx['j']] - ctx['cnt_1'][ctx['i']]",
      "next": 15
    },
    {
      "id": 15,
      "type": "decision",
      "label": "Is v1 == v2?",
      "logic": "ctx['v1'] == ctx['v2']",
      "true_next": 16,
      "false_next": 22
    },
    {
      "id": 16,
      "type": "decision",
      "label": "Is (v1 * v2) % k == 0?",
      "logic": "(ctx['v1'] * ctx['v2']) % ctx['k'] == 0",
      "true_next": 17,
      "false_next": 22
    },
    {
      "id": 17,
      "type": "process",
      "label": "Increment res by 1",
      "action": "ctx['res'] += 1",
      "next": 22
    },
    {
      "id": 22,
      "type": "process",
      "label": "Advance j: j += 1",
      "action": "ctx['j'] += 1",
      "next": 20
    },
    {
      "id": 21,
      "type": "process",
      "label": "Advance i: i += 1",
      "action": "ctx['i'] += 1",
      "next": 19
    },
    {
      "id": 18,
      "type": "end",
      "label": "Output: res (number of beautiful substrings)",
      "output": "ctx['res']"
    }
  ]
}
