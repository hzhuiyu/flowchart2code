{
  "problem_id": "countSubarrays",
  "nodes": [
    {
      "id": 1,
      "type": "start",
      "label": "Start",
      "next": 2
    },
    {
      "id": 2,
      "type": "process",
      "label": "Input: k (int), nums (list); maxVal, count, left, res init",
      "action": "ctx['k'] = ctx['arg0']; ctx['nums'] = ctx['arg1']; ctx['maxVal'] = max(ctx['nums']); ctx['count'] = 0; ctx['left'] = 0; ctx['res'] = 0; ctx['right'] = 0",
      "next": 3
    },
    {
      "id": 3,
      "type": "decision",
      "label": "For each val in nums (more?)",
      "logic": "ctx['right'] < len(ctx['nums'])",
      "true_next": 4,
      "false_next": 12
    },
    {
      "id": 4,
      "type": "decision",
      "label": "Is val == maxVal?",
      "logic": "ctx['nums'][ctx['right']] == ctx['maxVal']",
      "true_next": 5,
      "false_next": 8
    },
    {
      "id": 5,
      "type": "process",
      "label": "Increment count by 1",
      "action": "ctx['count'] += 1",
      "next": 6
    },
    {
      "id": 6,
      "type": "decision",
      "label": "Is count >= k?",
      "logic": "ctx['count'] >= ctx['k']",
      "true_next": 7,
      "false_next": 8
    },
    {
      "id": 7,
      "type": "decision",
      "label": "Is nums[left] == maxVal?",
      "logic": "ctx['nums'][ctx['left']] == ctx['maxVal']",
      "true_next": 9,
      "false_next": 10
    },
    {
      "id": 9,
      "type": "process",
      "label": "Decrement count by 1",
      "action": "ctx['count'] -= 1",
      "next": 10
    },
    {
      "id": 10,
      "type": "process",
      "label": "Increment left by 1",
      "action": "ctx['left'] += 1",
      "next": 6
    },
    {
      "id": 8,
      "type": "process",
      "label": "Increment res by left",
      "action": "ctx['res'] += ctx['left']",
      "next": 11
    },
    {
      "id": 11,
      "type": "process",
      "label": "Advance right: right += 1",
      "action": "ctx['right'] += 1",
      "next": 3
    },
    {
      "id": 12,
      "type": "end",
      "label": "Output: res (number of subarrays)",
      "output": "ctx['res']"
    }
  ]
}
