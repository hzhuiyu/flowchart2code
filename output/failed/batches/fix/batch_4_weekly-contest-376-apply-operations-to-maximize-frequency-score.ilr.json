{
 "problem_id": "max_frequency_score",
 "nodes": [
  {
   "id": 1,
   "type": "start",
   "label": "Start",
   "next": 2
  },
  {
   "id": 2,
   "type": "process",
   "label": "Input: k (integer), nums (List[int])",
   "action": "ctx['k'] = ctx['arg0']; ctx['nums'] = ctx['arg1']",
   "next": 3
  },
  {
   "id": 3,
   "type": "process",
   "label": "Sort nums",
   "action": "ctx['nums'].sort()",
   "next": 4
  },
  {
   "id": 4,
   "type": "process",
   "label": "Initialize sum_vals = [0] + prefix sums of nums",
   "action": "ctx['sum_vals'] = [0]\nfor v in ctx['nums']:\n    ctx['sum_vals'].append(ctx['sum_vals'][-1] + v)",
   "next": 5
  },
  {
   "id": 5,
   "type": "process",
   "label": "Initialize left = 0, right = 0, best = 1",
   "action": "ctx['left'] = 0; ctx['right'] = 0; ctx['best'] = 1",
   "next": 6
  },
  {
   "id": 6,
   "type": "decision",
   "label": "Loop: while right < len(nums)",
   "logic": "ctx['right'] < len(ctx['nums'])",
   "true_next": 7,
   "false_next": 12
  },
  {
   "id": 7,
   "type": "process",
   "label": "Calculate mid = (right + left) // 2",
   "action": "ctx['mid'] = (ctx['right'] + ctx['left']) // 2",
   "next": 8
  },
  {
   "id": 8,
   "type": "process",
   "label": "Calculate val = cost of right half above nums[mid]",
   "action": "ctx['val'] = (ctx['sum_vals'][ctx['right'] + 1] - ctx['sum_vals'][ctx['mid'] + 1]) - (ctx['right'] - ctx['mid']) * ctx['nums'][ctx['mid']]",
   "next": 9
  },
  {
   "id": 9,
   "type": "process",
   "label": "Update val += cost of left half below nums[mid]",
   "action": "ctx['val'] += (ctx['mid'] - ctx['left']) * ctx['nums'][ctx['mid']] - (ctx['sum_vals'][ctx['mid']] - ctx['sum_vals'][ctx['left']])",
   "next": 10
  },
  {
   "id": 10,
   "type": "decision",
   "label": "Is val > k?",
   "logic": "ctx['val'] > ctx['k']",
   "true_next": 11,
   "false_next": 13
  },
  {
   "id": 11,
   "type": "process",
   "label": "Update left += 1 (shrink window, recheck same right)",
   "action": "ctx['left'] += 1",
   "next": 7
  },
  {
   "id": 13,
   "type": "process",
   "label": "Update best with window size, then advance right",
   "action": "if ctx['right'] - ctx['left'] + 1 > ctx['best']:\n    ctx['best'] = ctx['right'] - ctx['left'] + 1\nctx['right'] += 1",
   "next": 6
  },
  {
   "id": 12,
   "type": "return",
   "label": "Return best",
   "value": "ctx['best']"
  }
 ]
}