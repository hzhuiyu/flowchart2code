{
  "problem_id": "min_operations_to_reach_target",
  "nodes": [
    {
      "id": 1,
      "type": "start",
      "label": "Start",
      "next": 2
    },
    {
      "id": 2,
      "type": "process",
      "label": "Input: nums (list of integers), target (integer)",
      "action": "ctx['nums'] = ctx['arg0']; ctx['target'] = ctx['arg1']; ctx['ops'] = 0",
      "next": 3
    },
    {
      "id": 3,
      "type": "decision",
      "label": "Is sum(nums) < target?",
      "logic": "sum(ctx['nums']) < ctx['target']",
      "true_next": 4,
      "false_next": 5
    },
    {
      "id": 4,
      "type": "end",
      "label": "Output: -1 (impossible to reach target)",
      "output": "-1"
    },
    {
      "id": 5,
      "type": "process",
      "label": "Count elements per power-of-two level into cnt[32]",
      "action": "ctx['cnt'] = [0] * 32\nfor v in ctx['nums']:\n    ctx['cnt'][v.bit_length() - 1] += 1\nctx['i'] = 0",
      "next": 6
    },
    {
      "id": 6,
      "type": "decision",
      "label": "More target bits to process (i < 31)?",
      "logic": "ctx['i'] < 31",
      "true_next": 7,
      "false_next": 15
    },
    {
      "id": 7,
      "type": "decision",
      "label": "Is bit i of target set?",
      "logic": "(ctx['target'] >> ctx['i']) & 1 == 1",
      "true_next": 8,
      "false_next": 14
    },
    {
      "id": 8,
      "type": "decision",
      "label": "Is cnt[i] > 0?",
      "logic": "ctx['cnt'][ctx['i']] > 0",
      "true_next": 9,
      "false_next": 10
    },
    {
      "id": 9,
      "type": "process",
      "label": "Consume one element of level i",
      "action": "ctx['cnt'][ctx['i']] -= 1",
      "next": 14
    },
    {
      "id": 10,
      "type": "process",
      "label": "Find smallest j > i with cnt[j] > 0",
      "action": "ctx['j'] = ctx['i'] + 1\nwhile ctx['j'] < 32 and ctx['cnt'][ctx['j']] == 0:\n    ctx['j'] += 1",
      "next": 11
    },
    {
      "id": 11,
      "type": "decision",
      "label": "Is j == 32 (no element available)?",
      "logic": "ctx['j'] == 32",
      "true_next": 12,
      "false_next": 13
    },
    {
      "id": 12,
      "type": "end",
      "label": "Output: -1 (no splittable element left)",
      "output": "-1"
    },
    {
      "id": 13,
      "type": "process",
      "label": "Split 2^j down to 2^i: ops += j - i, produce leftovers",
      "action": "ctx['ops'] += ctx['j'] - ctx['i']; ctx['cnt'][ctx['j']] -= 1\nfor p in range(ctx['i'], ctx['j']):\n    ctx['cnt'][p] += 1\nctx['cnt'][ctx['i']] -= 1",
      "next": 14
    },
    {
      "id": 14,
      "type": "process",
      "label": "Carry surplus: two 2^i pieces act as one 2^(i+1)",
      "action": "ctx['cnt'][ctx['i'] + 1] += ctx['cnt'][ctx['i']] // 2; ctx['i'] += 1",
      "next": 6
    },
    {
      "id": 15,
      "type": "end",
      "label": "Output: ops (minimum operations)",
      "output": "ctx['ops']"
    }
  ]
}
