{
 "problem_id": "findMissingAndRepeatedValues",
 "nodes": [
  {
   "id": 1,
   "type": "start",
   "label": "Start",
   "next": 2
  },
  {
   "id": 2,
   "type": "process",
   "label": "Input: grid (2D integer matrix)",
   "action": "ctx['grid'] = ctx['arg0']; ctx['n'] = len(ctx['grid']); ctx['fre'] = [0] * (ctx['n'] * ctx['n'] + 1); ctx['rep'] = 0; ctx['mis'] = 0",
   "next": 3
  },
  {
   "id": 3,
   "type": "process",
   "label": "For each row in grid: count frequencies",
   "action": "for i in range(len(ctx['grid'])):\n    for num in ctx['grid'][i]:\n        ctx['fre'][num] += 1",
   "next": 4
  },
  {
   "id": 4,
   "type": "process",
   "label": "Initialize j = 1",
   "action": "ctx['j'] = 1",
   "next": 5
  },
  {
   "id": 5,
   "type": "decision",
   "label": "More values to check? (j <= n * n)",
   "logic": "ctx['j'] <= ctx['n'] * ctx['n']",
   "true_next": 6,
   "false_next": 9
  },
  {
   "id": 6,
   "type": "decision",
   "label": "Is fre[j] == 0?",
   "logic": "ctx['fre'][ctx['j']] == 0",
   "true_next": 7,
   "false_next": 8
  },
  {
   "id": 7,
   "type": "process",
   "label": "Set mis = j",
   "action": "ctx['mis'] = ctx['j']",
   "next": 8
  },
  {
   "id": 8,
   "type": "process",
   "label": "Set rep = j if fre[j] == 2, then advance j",
   "action": "if ctx['fre'][ctx['j']] == 2:\n    ctx['rep'] = ctx['j']\nctx['j'] += 1",
   "next": 5
  },
  {
   "id": 9,
   "type": "process",
   "label": "Return [rep, mis]",
   "action": "ctx['result'] = [ctx['rep'], ctx['mis']]",
   "next": 10
  },
  {
   "id": 10,
   "type": "end",
   "label": "End",
   "output": "ctx['result']"
  }
 ]
}