{
  "problem_id": "incremovableSubarrayCount",
  "nodes": [
    {
      "id": 1,
      "type": "start",
      "label": "Start",
      "next": 2
    },
    {
      "id": 2,
      "type": "process",
      "label": "Input: nums (List[int])",
      "action": "ctx['nums'] = ctx['arg0']; ctx['i'] = 0",
      "next": 3
    },
    {
      "id": 3,
      "type": "process",
      "label": "Add sentinels: nums = [0] + nums + [float('inf')]",
      "action": "ctx['nums'] = [0] + ctx['nums'] + [float('inf')]",
      "next": 4
    },
    {
      "id": 4,
      "type": "process",
      "label": "Initialize n = length of nums",
      "action": "ctx['n'] = len(ctx['nums'])",
      "next": 5
    },
    {
      "id": 5,
      "type": "decision",
      "label": "Prefix scan: i < n - 2 and nums[i] < nums[i + 1]?",
      "logic": "ctx['i'] < ctx['n'] - 2 and ctx['nums'][ctx['i']] < ctx['nums'][ctx['i'] + 1]",
      "true_next": 7,
      "false_next": 8
    },
    {
      "id": 7,
      "type": "process",
      "label": "Advance prefix end: i += 1",
      "action": "ctx['i'] += 1",
      "next": 5
    },
    {
      "id": 8,
      "type": "decision",
      "label": "Is the whole array strictly increasing (i reached n - 2)?",
      "logic": "ctx['i'] >= ctx['n'] - 2",
      "true_next": 9,
      "false_next": 10
    },
    {
      "id": 9,
      "type": "process",
      "label": "Output: res = (n - 2) * (n - 1) // 2",
      "action": "ctx['res'] = (ctx['n'] - 2) * (ctx['n'] - 1) // 2",
      "next": 18
    },
    {
      "id": 10,
      "type": "process",
      "label": "Initialize suffix scan: j = n - 1",
      "action": "ctx['j'] = ctx['n'] - 1",
      "next": 11
    },
    {
      "id": 11,
      "type": "decision",
      "label": "Suffix scan: j - 1 >= 1 and nums[j - 1] < nums[j]?",
      "logic": "ctx['j'] - 1 >= 1 and ctx['nums'][ctx['j'] - 1] < ctx['nums'][ctx['j']]",
      "true_next": 12,
      "false_next": 13
    },
    {
      "id": 12,
      "type": "process",
      "label": "Advance suffix start: j -= 1",
      "action": "ctx['j'] -= 1",
      "next": 11
    },
    {
      "id": 13,
      "type": "process",
      "label": "Initialize l = 0, r = j, res = 0",
      "action": "ctx['l'] = 0; ctx['r'] = ctx['j']; ctx['res'] = 0",
      "next": 14
    },
    {
      "id": 14,
      "type": "decision",
      "label": "Is l <= i (kept prefix end within scan range)?",
      "logic": "ctx['l'] <= ctx['i']",
      "true_next": 15,
      "false_next": 18
    },
    {
      "id": 15,
      "type": "process",
      "label": "Advance r while nums[r] <= nums[l]",
      "action": "while ctx['r'] < ctx['n'] and ctx['nums'][ctx['l']] >= ctx['nums'][ctx['r']]: ctx['r'] += 1",
      "next": 17
    },
    {
      "id": 17,
      "type": "process",
      "label": "Update res: res += n - r; advance l",
      "action": "ctx['res'] += ctx['n'] - ctx['r']; ctx['l'] += 1",
      "next": 14
    },
    {
      "id": 18,
      "type": "end",
      "label": "Return res",
      "output": "ctx['res']"
    }
  ]
}
