      "true_next": 6,
      "false_next": 13
    },
    {
      "id": 6,
      "type": "decision",
      "label": "Is k greater than total visited integers (ci <= 0)?",
      "logic": "ctx['ci'] <= 0",
      "true_next": 8,
      "false_next": 10
    },
    {
      "id": 8,
      "type": "process",
      "label": "Append -1 to ans",
      "action": "ctx['ans'].append(-1)",
      "next": 3
    },
    {
      "id": 9,
      "type": "process",
      "label": "Append ov[ci] to ans",
      "action": "ctx['ans'].append(ctx['ov'][ctx['ci']])",
