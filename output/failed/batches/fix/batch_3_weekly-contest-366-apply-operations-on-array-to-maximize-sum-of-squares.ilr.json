{
  "problem_id": "maxSum",
  "nodes": [
    {
      "id": 1,
      "type": "start",
      "label": "Start",
      "next": 2
    },
    {
      "id": 2,
      "type": "process",
      "label": "Input: k (int), nums (List[int])",
      "action": "ctx['k'] = ctx['arg0']; ctx['nums'] = ctx['arg1']; ctx['n'] = len(ctx['nums']); ctx['IDX'] = [0] * 32; ctx['ans'] = [0] * ctx['n']",
      "next": 17
    },
    {
      "id": 17,
      "type": "process",
      "label": "Init element index p = 0",
      "action": "ctx['p'] = 0",
      "next": 3
    },
    {
      "id": 3,
      "type": "decision",
      "label": "More elements (p < n)?",
      "logic": "ctx['p'] < ctx['n']",
      "true_next": 4,
      "false_next": 11
    },
    {
      "id": 4,
      "type": "process",
      "label": "Take x = nums[p], advance p, start bit scan i = 0",
      "action": "ctx['x'] = ctx['nums'][ctx['p']]; ctx['p'] += 1; ctx['i'] = 0",
      "next": 20
    },
    {
      "id": 20,
      "type": "decision",
      "label": "More bits (i < 32)?",
      "logic": "ctx['i'] < 32",
      "true_next": 5,
      "false_next": 3
    },
    {
      "id": 5,
      "type": "decision",
      "label": "Is (x >> i) & 1 == 1?",
      "logic": "(ctx['x'] >> ctx['i']) & 1 == 1",
      "true_next": 6,
      "false_next": 7
    },
    {
      "id": 6,
      "type": "process",
      "label": "ans[IDX[i]] += 1 << i; IDX[i] += 1",
      "action": "ctx['ans'][ctx['IDX'][ctx['i']]] += (1 << ctx['i']); ctx['IDX'][ctx['i']] += 1",
      "next": 7
    },
    {
      "id": 7,
      "type": "process",
      "label": "i += 1",
      "action": "ctx['i'] += 1",
      "next": 20
    },
    {
      "id": 11,
      "type": "process",
      "label": "Initialize res = 0",
      "action": "ctx['res'] = 0",
      "next": 12
    },
    {
      "id": 12,
      "type": "process",
      "label": "Initialize mod = 10 ** 9 + 7",
      "action": "ctx['mod'] = 10**9 + 7",
      "next": 22
    },
    {
      "id": 22,
      "type": "process",
      "label": "Init query index i = 0",
      "action": "ctx['i'] = 0",
      "next": 13
    },
    {
      "id": 13,
      "type": "decision",
      "label": "For i from 0 to k-1",
      "logic": "ctx['i'] < ctx['k']",
      "true_next": 14,
      "false_next": 16
    },
    {
      "id": 14,
      "type": "process",
      "label": "Update res += ans[i] ** 2",
      "action": "ctx['res'] += ctx['ans'][ctx['i']] ** 2",
      "next": 15
    },
    {
      "id": 15,
      "type": "process",
      "label": "Update res %= mod, i += 1",
      "action": "ctx['res'] %= ctx['mod']; ctx['i'] += 1",
      "next": 13
    },
    {
      "id": 16,
      "type": "end",
      "label": "Output: res (maximum sum of squares)",
      "output": "ctx['res']"
    }
  ]
}
