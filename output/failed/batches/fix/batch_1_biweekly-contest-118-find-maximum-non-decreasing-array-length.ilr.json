{
  "problem_id": "findMaximumLength",
  "nodes": [
    {
      "id": 1,
      "type": "start",
      "label": "Start",
      "next": 2
    },
    {
      "id": 2,
      "type": "process",
      "label": "Input: nums (list of integers)",
      "action": "ctx['nums'] = ctx['arg0']; ctx['n'] = len(ctx['nums']); ctx['pre'] = [0]; ctx['dp'] = {}; ctx['i'] = 1",
      "next": 3
    },
    {
      "id": 3,
      "type": "process",
      "label": "Build prefix sums pre",
      "action": "for v in ctx['nums']:\n    ctx['pre'].append(ctx['pre'][-1] + v)",
      "next": 5
    },
    {
      "id": 5,
      "type": "process",
      "label": "Set dp[0] = (0, 0)",
      "action": "ctx['dp'][0] = (0, 0)",
      "next": 6
    },
    {
      "id": 6,
      "type": "decision",
      "label": "Is i <= n?",
      "logic": "ctx['i'] <= ctx['n']",
      "true_next": 7,
      "false_next": 10
    },
    {
      "id": 7,
      "type": "process",
      "label": "Initialize inner index j = 0",
      "action": "ctx['j'] = 0",
      "next": 8
    },
    {
      "id": 8,
      "type": "decision",
      "label": "Is j < i?",
      "logic": "ctx['j'] < ctx['i']",
      "true_next": 9,
      "false_next": 17
    },
    {
      "id": 9,
      "type": "decision",
      "label": "Can elements j+1..i form a valid last group (sum >= dp[j] last sum)?",
      "logic": "ctx['pre'][ctx['i']] - ctx['pre'][ctx['j']] >= -ctx['dp'][ctx['j']][1]",
      "true_next": 11,
      "false_next": 12
    },
    {
      "id": 11,
      "type": "process",
      "label": "Update dp[i] = max(dp[i], (dp[j][0] + 1, -(pre[i] - pre[j])))",
      "action": "ctx['dp'][ctx['i']] = max(ctx['dp'].get(ctx['i'], (0, 0)), (ctx['dp'][ctx['j']][0] + 1, -(ctx['pre'][ctx['i']] - ctx['pre'][ctx['j']])))",
      "next": 13
    },
    {
      "id": 12,
      "type": "process",
      "label": "Advance inner index j += 1",
      "action": "ctx['j'] += 1",
      "next": 8
    },
    {
      "id": 13,
      "type": "process",
      "label": "Advance inner index j += 1",
      "action": "ctx['j'] += 1",
      "next": 8
    },
    {
      "id": 17,
      "type": "process",
      "label": "Continue to next iteration: i += 1",
      "action": "ctx['i'] += 1",
      "next": 6
    },
    {
      "id": 10,
      "type": "end",
      "label": "Return dp[n][0] as output",
      "output": "ctx['dp'][ctx['n']][0]"
    }
  ]
}
