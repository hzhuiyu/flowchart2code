{
  "problem_id": "largestPerimeter",
  "nodes": [
    {"id": 1, "type": "start", "label": "Start", "next": 2},
    {"id": 2, "type": "process", "label": "Input: nums (List[int])", "action": "ctx['nums'] = ctx['arg0']; ctx['p'] = sum(ctx['nums']); ctx['found'] = False; ctx['i'] = 0", "next": 3},
    {"id": 3, "type": "process", "label": "Sort nums in descending order", "action": "ctx['nums'] = sorted(ctx['nums'], reverse=True)", "next": 4},
    {"id": 4, "type": "decision", "label": "At least 3 sides remain? (i < len(nums) - 2)", "logic": "ctx['i'] < len(ctx['nums']) - 2", "true_next": 11, "false_next": 8},
    {"id": 11, "type": "process", "label": "v = nums[i]", "action": "ctx['current_v'] = ctx['nums'][ctx['i']]", "next": 5},
    {"id": 5, "type": "decision", "label": "Is v < p - v?", "logic": "ctx['current_v'] < ctx['p'] - ctx['current_v']", "true_next": 6, "false_next": 7},
    {"id": 6, "type": "process", "label": "Valid polygon found (keep p as perimeter)", "action": "ctx['found'] = True", "next": 8},
    {"id": 7, "type": "process", "label": "Exclude v: p -= v; i += 1", "action": "ctx['p'] -= ctx['current_v']; ctx['i'] += 1", "next": 4},
    {"id": 8, "type": "decision", "label": "Did we find a valid perimeter?", "logic": "ctx['found']", "true_next": 9, "false_next": 10},
    {"id": 9, "type": "return", "label": "Return p (largest valid perimeter)", "value": "ctx['p']"},
    {"id": 10, "type": "return", "label": "Return -1 (no valid polygon)", "value": "-1"}
  ]
}
