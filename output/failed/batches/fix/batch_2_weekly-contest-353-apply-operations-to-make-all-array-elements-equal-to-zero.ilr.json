{
  "problem_id": "checkArray",
  "nodes": [
    {"id": 1, "type": "start", "label": "Start", "next": 2},
    {"id": 2, "type": "process", "label": "Input: k (integer), nums (list of integers)", "action": "ctx['k'] = ctx['arg0']; ctx['nums'] = ctx['arg1']; ctx['arr'] = [0] * (len(ctx['nums']) + 1); ctx['h'] = 0; ctx['i'] = 0", "next": 3},
    {"id": 3, "type": "decision", "label": "Is i < len(nums)?", "logic": "ctx['i'] < len(ctx['nums'])", "true_next": 4, "false_next": 14},
    {"id": 4, "type": "process", "label": "Extract current element: n = nums[i]", "action": "ctx['n'] = ctx['nums'][ctx['i']]", "next": 5},
    {"id": 5, "type": "process", "label": "Update h: h -= arr[i]", "action": "ctx['h'] -= ctx['arr'][ctx['i']]", "next": 6},
    {"id": 6, "type": "decision", "label": "Is n > h?", "logic": "ctx['n'] > ctx['h']", "true_next": 7, "false_next": 8},
    {"id": 7, "type": "decision", "label": "Is i + k > len(nums)?", "logic": "ctx['i'] + ctx['k'] > len(ctx['nums'])", "true_next": 9, "false_next": 11},
    {"id": 8, "type": "decision", "label": "Is n < h?", "logic": "ctx['n'] < ctx['h']", "true_next": 10, "false_next": 12},
    {"id": 9, "type": "process", "label": "Output: False (cannot apply operation)", "action": "ctx['result'] = False", "next": 16},
    {"id": 10, "type": "process", "label": "Output: False (current element is less than h)", "action": "ctx['result'] = False", "next": 16},
    {"id": 11, "type": "process", "label": "Update arr[i + k]: arr[i + k] = n - h", "action": "ctx['arr'][ctx['i'] + ctx['k']] = ctx['n'] - ctx['h']", "next": 13},
    {"id": 12, "type": "process", "label": "Continue to next iteration", "action": "ctx['i'] += 1", "next": 3},
    {"id": 13, "type": "process", "label": "Update h: h = n", "action": "ctx['h'] = ctx['n']", "next": 12},
    {"id": 14, "type": "process", "label": "Output: True (all elements can be made zero)", "action": "ctx['result'] = True", "next": 16},
    {"id": 16, "type": "end", "label": "Return result", "output": "ctx['result']"}
  ]
}
