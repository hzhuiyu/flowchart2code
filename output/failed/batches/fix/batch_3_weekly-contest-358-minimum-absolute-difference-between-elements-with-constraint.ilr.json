{
  "problem_id": "min_absolute_difference",
  "nodes": [
    {
      "id": 1,
      "type": "start",
      "label": "Start",
      "next": 2
    },
    {
      "id": 2,
      "type": "process",
      "label": "Input: nums (List[int]), x (integer)",
      "action": "ctx['nums'] = ctx['arg0']; ctx['x'] = ctx['arg1']; ctx['res'] = float('inf'); ctx['S'] = []",
      "next": 3
    },
    {
      "id": 3,
      "type": "decision",
      "label": "Is x == 0?",
      "logic": "ctx['x'] == 0",
      "true_next": 4,
      "false_next": 5
    },
    {
      "id": 4,
      "type": "return",
      "label": "Output: 0 (no indices apart)",
      "value": "0"
    },
    {
      "id": 5,
      "type": "process",
      "label": "Initialize res = infinity, S = sorted window list",
      "action": "ctx['res'] = float('inf'); ctx['S'] = []",
      "next": 6
    },
    {
      "id": 6,
      "type": "process",
      "label": "Loop over i from 0 to len(nums)-1",
      "action": "ctx['i'] = 0",
      "next": 7
    },
    {
      "id": 7,
      "type": "decision",
      "label": "Is i >= len(nums)?",
      "logic": "ctx['i'] >= len(ctx['nums'])",
      "true_next": 14,
      "false_next": 16
    },
    {
      "id": 16,
      "type": "decision",
      "label": "Is i >= x?",
      "logic": "ctx['i'] >= ctx['x']",
      "true_next": 13,
      "false_next": 15
    },
    {
      "id": 13,
      "type": "process",
      "label": "Add nums[i - x] to S and keep S sorted",
      "action": "ctx['S'].append(ctx['nums'][ctx['i'] - ctx['x']]); ctx['S'] = sorted(ctx['S'])",
      "next": 15
    },
    {
      "id": 15,
      "type": "process",
      "label": "Set j = bisect_left(S, nums[i]) via binary search",
      "action": "ctx['t'] = ctx['nums'][ctx['i']]\nlo = 0\nhi = len(ctx['S'])\nwhile lo < hi:\n    mid = (lo + hi) // 2\n    if ctx['S'][mid] < ctx['t']:\n        lo = mid + 1\n    else:\n        hi = mid\nctx['j'] = lo",
      "next": 8
    },
    {
      "id": 8,
      "type": "decision",
      "label": "Is j < len(S)?",
      "logic": "ctx['j'] < len(ctx['S'])",
      "true_next": 9,
      "false_next": 10
    },
    {
      "id": 9,
      "type": "process",
      "label": "Update res: res = min(res, abs(S[j] - nums[i]))",
      "action": "ctx['res'] = min(ctx['res'], abs(ctx['S'][ctx['j']] - ctx['nums'][ctx['i']]))",
      "next": 10
    },
    {
      "id": 10,
      "type": "decision",
      "label": "Is j > 0?",
      "logic": "ctx['j'] > 0",
      "true_next": 11,
      "false_next": 12
    },
    {
      "id": 11,
      "type": "process",
      "label": "Update res: res = min(res, abs(S[j-1] - nums[i]))",
      "action": "ctx['res'] = min(ctx['res'], abs(ctx['S'][ctx['j'] - 1] - ctx['nums'][ctx['i']]))",
      "next": 12
    },
    {
      "id": 12,
      "type": "process",
      "label": "End Loop",
      "action": "ctx['i'] += 1",
      "next": 7
    },
    {
      "id": 14,
      "type": "return",
      "label": "Output: res (minimum absolute difference)",
      "value": "ctx['res']"
    }
  ]
}
